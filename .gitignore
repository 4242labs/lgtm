node_modules/
reports/
*.log
.DS_Store
# transient auth material — never commit a captured session
sites/*.storageState.json
.auth/
# real site configs stay local; only the template is committed
sites/*.yaml
!sites/example.yaml

# Claude Code -- local-only files stay untracked (kit hygiene)
.claude/settings.local.json
.claude/worktrees/
.claude/hooks/*.local.json
.worktrees/

# Python bytecode from running .github/scripts locally
__pycache__/
*.pyc
